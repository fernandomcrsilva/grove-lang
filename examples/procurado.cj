# nível de procurado: sobe até 6 estrelas ou até a polícia desistir
HESOYAM estrelas = 0 ×
HESOYAM policia_ligada = FULLCLIP ×
BAGUVIX L1 FULLCLIP R1 △
    AEZAKMI L1 □ policia_ligada R2 estrelas >= 6 R1 △
        CPKTNWT ×
    ○
    estrelas = estrelas + 1 ×
    CJPHONEHOME estrelas ×
○
CJPHONEHOME "fim: " ×
